---
import { base } from '../consts';
import { findRelated, findSiblings, postSlug, readingMinutes, type Post } from '../lib/posts';

export interface Props {
  current: Post;
  all: Post[];
}

const { current, all } = Astro.props;

const { newer, older } = findSiblings(current, all);

// 「上一篇 / 下一篇」已经露脸的文章不再进「相关文章」，否则同一屏两个区块会重复推同一篇
// （例如 claude-code-commands 页，两个区块的首卡与次卡完全相同）。
const siblingIds = [newer?.id, older?.id].filter((id): id is string => Boolean(id));
const related = findRelated(current, all, { exclude: siblingIds });

const href = (entry: Post) => `${base}/posts/${postSlug(entry.id)}/`;
---

{
  (newer || older) && (
    <nav class="post-siblings" aria-label="上一篇 / 下一篇">
      {newer ? (
        <a class="sibling sibling--prev" href={href(newer)} rel="prev">
          <span class="sibling-arrow" aria-hidden="true">←</span>
          <span class="sibling-body">
            <span class="sibling-label">上一篇</span>
            <span class="sibling-title">{newer.data.title}</span>
          </span>
        </a>
      ) : (
        <span />
      )}
      {older && (
        <a class="sibling sibling--next" href={href(older)} rel="next">
          <span class="sibling-arrow" aria-hidden="true">→</span>
          <span class="sibling-body">
            <span class="sibling-label">下一篇</span>
            <span class="sibling-title">{older.data.title}</span>
          </span>
        </a>
      )}
    </nav>
  )
}

{
  related.length > 0 && (
    <section class="related" aria-labelledby="related-heading">
      <h2 id="related-heading" class="related-heading">相关文章</h2>
      <ul class="related-list">
        {related.map((entry) => (
          <li>
            <a class="related-card" href={href(entry)}>
              <span class="related-meta">
                {entry.data.date && (
                  <time datetime={entry.data.date.toISOString()}>
                    {entry.data.date.toLocaleDateString('zh-CN')}
                  </time>
                )}
                <span class="related-dot" aria-hidden="true" />
                <span>{readingMinutes(entry.body)} 分钟</span>
              </span>
              <span class="related-title">{entry.data.title}</span>
              <span class="related-desc">{entry.data.description}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )
}

<style>
  /* ── 上一篇 / 下一篇：方向箭头做成方块筹码，悬停整卡描边转强调色 ── */
  .post-siblings {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(16rem, 100%), 1fr));
    gap: 0.9rem;
    margin-top: 3.25rem;
  }
  .sibling {
    display: flex;
    align-items: flex-start;
    gap: 0.85rem;
    padding: 1.05rem 1.15rem;
    border: 1px solid var(--sl-color-gray-6, var(--sl-color-gray-5));
    border-radius: 0.8rem;
    text-decoration: none;
    transition: border-color 0.18s, transform 0.18s, box-shadow 0.18s;
  }
  .sibling:hover {
    border-color: var(--sl-color-text-accent);
    transform: translateY(-2px);
    box-shadow: 0 8px 20px -14px hsl(224 60% 20% / 0.45);
  }
  /* 仅有下一篇（最新一篇）时不再半边留白：空占位退出栅格后 auto-fit 会把这张卡撑满整行 */
  .post-siblings > span:empty {
    display: none;
  }
  .sibling-arrow {
    flex: none;
    width: 1.9rem;
    height: 1.9rem;
    display: grid;
    place-items: center;
    border-radius: 0.5rem;
    background: var(--sl-color-gray-6, #f3f4f6);
    color: var(--sl-color-gray-2);
    font-size: 0.92rem;
    line-height: 1;
    transition: background-color 0.18s, color 0.18s;
  }
  .sibling:hover .sibling-arrow {
    background: var(--sl-color-text-accent);
    color: #fff;
  }
  .sibling-body {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    min-width: 0;
  }
  .sibling-label {
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    color: var(--sl-color-gray-4);
  }
  .sibling-title {
    color: var(--sl-color-white);
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.5;
    overflow-wrap: anywhere;
    transition: color 0.18s;
  }
  .sibling:hover .sibling-title {
    color: var(--sl-color-text-accent);
  }

  /* ── 相关文章：日期/时长提到标题上方，描述截两行，卡片等高 ── */
  .related {
    margin-top: 2.75rem;
    padding-top: 2rem;
    border-top: 1px solid var(--sl-color-hairline);
  }
  .related-heading {
    margin: 0 0 1.15rem;
    font-size: 0.9rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--sl-color-gray-3);
  }
  .related-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(18rem, 100%), 1fr));
    gap: 0.9rem;
  }
  .related-list li {
    display: flex;
  }
  .related-card {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.42rem;
    padding: 1.05rem 1.15rem;
    border: 1px solid var(--sl-color-gray-6, var(--sl-color-gray-5));
    border-radius: 0.8rem;
    text-decoration: none;
    transition: border-color 0.18s, transform 0.18s, box-shadow 0.18s;
  }
  .related-card:hover {
    border-color: var(--sl-color-text-accent);
    transform: translateY(-2px);
    box-shadow: 0 8px 20px -14px hsl(224 60% 20% / 0.45);
  }
  .related-meta {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.74rem;
    color: var(--sl-color-gray-4);
  }
  .related-dot {
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: currentColor;
    opacity: 0.6;
  }
  .related-title {
    color: var(--sl-color-white);
    font-size: 0.98rem;
    font-weight: 600;
    line-height: 1.5;
    overflow-wrap: anywhere;
    transition: color 0.18s;
  }
  .related-card:hover .related-title {
    color: var(--sl-color-text-accent);
  }
  .related-desc {
    margin: 0;
    font-size: 0.87rem;
    line-height: 1.65;
    color: var(--sl-color-gray-3);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .sibling:focus-visible,
  .related-card:focus-visible {
    outline: 2px solid var(--sl-color-text-accent);
    outline-offset: 2px;
  }
</style>
