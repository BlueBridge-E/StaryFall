---
export interface Props {
  title: string;
}

const { title } = Astro.props;
const base = '/StaryFall';
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} | StaryFall</title>
  </head>
  <body>
    <header class="tag-header">
      <a href={`${base}/`} class="back-home">&larr; StaryFall</a>
      <h1>{title}</h1>
    </header>
    <main class="tag-main">
      <slot />
    </main>
  </body>
</html>

<style>
  :root {
    --sl-color-text-accent: #2563eb;
    --sl-color-gray-2: #6b7280;
    --sl-color-gray-4: #d1d5db;
    --sl-color-gray-5: #e5e7eb;
    --sl-color-gray-7: #f3f4f6;
  }
  * { box-sizing: border-box; margin: 0; padding: 0; }
  body {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Noto Sans SC", sans-serif;
    line-height: 1.6;
    color: #1a1a2e;
    background: #fafafa;
    max-width: 720px;
    margin: 0 auto;
    padding: 2rem 1.5rem;
  }
  .tag-header {
    margin-bottom: 2rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--sl-color-gray-5);
  }
  .back-home {
    font-size: 0.9rem;
    color: var(--sl-color-gray-2);
    text-decoration: none;
  }
  .back-home:hover { color: var(--sl-color-text-accent); }
  h1 {
    font-size: 1.75rem;
    margin-top: 0.5rem;
    color: var(--sl-color-text-accent);
  }
  a { color: inherit; }
</style>
