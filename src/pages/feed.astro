---
// src/pages/feed.astro — AI 新闻速递
// 数据文件: public/ai-news.json（由 cron 定时更新）
import { base } from '../consts';
import SiteHead from '../components/SiteHead.astro';
import '../styles/tokens.css';
import '../styles/hero.css';

interface NewsItem {
  title: string;
  summary: string;
  url?: string;
  source?: string;
  date?: string;
}
interface NewsData {
  lastUpdated?: string;
  items: NewsItem[];
}
let newsData: NewsData | null = null;
try {
  const mod = await import('../../public/ai-news.json') as { default: NewsData };
  newsData = mod.default;
} catch (error) {
  // 不再静默吞掉：JSON 损坏或文件缺失时必须在构建期暴露，
  // 否则 cron 写出坏数据会以「成功」的构建发布一个空状态页面。
  throw new Error(
    `无法加载 public/ai-news.json，请检查 cron 输出是否为合法 JSON：${(error as Error).message}`,
  );
}
const items = newsData?.items ?? [];
const lastUpdated = newsData?.lastUpdated ?? '';

const pageTitle = 'AI 速递 — StaryFall';
const pageDescription = 'AI 热点资讯精选，每周三、周日更新，聚合多源报道与要点摘要。';

// 按月分组，用 #YYYY-MM 锚点分享/直达某个月（由 scripts/pagination.ts 跳到该月所在页）。
const monthOf = (date: string | undefined) => (date ?? '').slice(0, 7);
const months = [...new Set(items.map((item) => monthOf(item.date)).filter(Boolean))].sort().reverse();
const monthLabel = (key: string) => {
  const [year, month] = key.split('-');
  return `${year} 年 ${Number(month)} 月`;
};
const monthCount = (key: string) => items.filter((item) => monthOf(item.date) === key).length;

// 月份标题必须就地渲染在所属月份的第一张卡片之前，不能集中放在所有卡片之前：
// 集中放置时标题只能靠 JS 搬回原位，而条目不足一页时 feed.astro 根本不渲染分页容器，
// pagination.ts 会在拿到容器前就 return —— 标题全部停留在顶部（或带 hidden 时全部消失），
// 整页退化成不带分组的裸列表。就地渲染后，无 JS 也是正确的分组结构。
const itemsWithMonthStart = items.map((item, i) => {
  const month = monthOf(item.date);
  const prev = i > 0 ? monthOf(items[i - 1]!.date) : null;
  return { item, month, monthStart: month !== '' && prev !== month };
});
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <SiteHead title={pageTitle} description={pageDescription} path="/feed/" />
  </head>
  <body>
    <header class="hero">
      <div class="hero-inner">
        <p class="hero-badge">
          <span class="dot" aria-hidden="true"></span>
          {items.length} 条资讯 · {months.length} 个月
        </p>
        <h1><span aria-hidden="true">🤖</span> AI 速递</h1>
        <p class="tagline">AI 热点资讯精选 · 每周三、周日更新</p>
        <nav class="hero-nav" aria-label="站点导航">
          <a href={`${base}/`}>首页</a>
          <a href={`${base}/tags/`}>标签</a>
          <a href={`${base}/work/`}>作品</a>
        </nav>
      </div>
    </header>

    {lastUpdated && (
      <p class="feed-meta">最近更新：{new Date(lastUpdated).toLocaleString('zh-CN', { timeZone: 'Asia/Shanghai', year: 'numeric', month: 'long', day: 'numeric', hour: '2-digit', minute: '2-digit' })}</p>
    )}

    {months.length > 1 && (
      <nav class="month-nav" aria-label="按月跳转">
        <span class="month-nav-label">按月跳转：</span>
        {months.map((key) => (
          <a href={`#${key}`}>{monthLabel(key)}<span class="month-nav-count">{monthCount(key)}</span></a>
        ))}
      </nav>
    )}

    <main class="post-list">
      {items.length === 0 ? (
        <p class="empty-state"><span aria-hidden="true">📭</span> 资讯数据准备中，稍后回来查看</p>
      ) : (
        <>
          {itemsWithMonthStart.map(({ item, month, monthStart }) => (
            <>
              {monthStart && (
                <h2 class="month-heading" id={month} data-month-heading={month}>
                  {monthLabel(month)}
                  <span class="month-heading-count">{monthCount(month)} 条</span>
                </h2>
              )}
              <article class="post-card news-card" data-pagination-card data-month={month}>
                <h3 class="news-title">{item.title}</h3>
                <div class="news-source">
                  {item.source && <span class="source-name">{item.source}</span>}
                  {item.date && <span class="source-date">{item.date}</span>}
                  <span class="source-arrow" aria-hidden="true">▾</span>
                </div>
                <p class="news-summary">{item.summary}</p>
                {item.url ? (
                  <a href={item.url} class="news-link" target="_blank" rel="noopener">
                    阅读原文 <span aria-hidden="true">↗</span>
                  </a>
                ) : (
                  <span class="news-link disabled">暂无链接</span>
                )}
              </article>
            </>
          ))}
        </>
      )}
    </main>

    {items.length > 10 && (
      <nav class="pagination" id="pagination" data-pagination data-page-size="10" aria-label="分页">
        <button class="page-btn" id="firstPage">
          <span aria-hidden="true">«</span> 第一页
        </button>
        <button class="page-btn" id="prevPage"><span aria-hidden="true">←</span> 上一页</button>
        <span class="page-info" id="pageInfo"></span>
        <button class="page-btn" id="nextPage">下一页 <span aria-hidden="true">→</span></button>
        <button class="page-btn" id="lastPage">
          最后一页 <span aria-hidden="true">»</span>
        </button>
      </nav>
    )}

    <footer class="footer">
      <p>Built with Astro + Starlight</p>
    </footer>

    <script>
      import { initPagination } from '../scripts/pagination';
      initPagination();
    </script>

<style>
  body {
    font-family: var(--font-sans);
    line-height: 1.6;
    color: var(--text);
    background: var(--bg);
  }

  /* 头图样式在 src/styles/hero.css（与首页、/work 共用） */

  /* 月份导航条 */
  .month-nav {
    max-width: var(--page-max);
    margin: 0 auto;
    padding: 0 1.5rem 0.5rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem 0.6rem;
    font-size: 0.85rem;
  }
  .month-nav-label {
    color: var(--muted);
  }
  .month-nav a {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.2em 0.6em;
    border: 1px solid var(--border);
    border-radius: 6px;
    background: var(--card-bg);
    color: var(--accent);
    text-decoration: none;
    transition: border-color 0.2s, background 0.2s;
  }
  .month-nav a:hover {
    border-color: var(--accent);
    background: var(--accent-soft);
  }
  .month-nav-count {
    font-size: 0.75rem;
    color: var(--muted);
  }

  /* 月份标题：就地渲染在所属月份之前；脚本只在「该月跨页」时把它搬到当前页首条卡片前。
     没有 JS（或条目不足一页、分页容器未渲染）时，标题留在原位即可正确分组。 */
  .month-heading {
    scroll-margin-top: 1rem;
    margin: 2rem 0 0.75rem;
    padding-bottom: 0.5rem;
    border-bottom: 2px solid var(--border);
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--text);
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
  }
  .month-heading:first-child {
    margin-top: 0.5rem;
  }
  .month-heading[hidden] {
    display: none;
  }
  .month-heading:target {
    color: var(--accent);
    border-bottom-color: var(--accent);
  }
  .month-heading:target .month-heading-count {
    color: var(--accent);
  }
  .month-heading-count {
    font-size: 0.78rem;
    font-weight: 500;
    color: var(--muted);
  }

  .feed-meta {
    max-width: var(--page-max);
    margin: 1.25rem auto 1rem;
    padding: 0 1.5rem;
    font-size: 0.85rem;
    color: var(--muted);
  }

  /*
   * 双列栅格。月份标题与卡片是同一个容器的兄弟节点（分页脚本会 insertBefore
   * 移动标题），所以标题要显式跨满整行，否则它会挤进某一列。
   */
  .post-list {
    max-width: var(--page-max);
    margin: 0 auto;
    padding: 1rem 1.5rem 4rem;
    display: grid;
    /* min() 夹住列宽下限：视口窄于 420px 时列宽自动退到 100%，
       否则 minmax(420px, 1fr) 会强制 420px 把整页撑出横向滚动条（手机竖屏） */
    grid-template-columns: repeat(auto-fill, minmax(min(420px, 100%), 1fr));
    gap: 1rem;
    align-content: start;
  }
  .month-heading,
  .empty-state {
    grid-column: 1 / -1;
  }

  .post-card {
    padding: 1.5rem;
    margin-bottom: 0;
    background: var(--card-bg);
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-card);
    transition: box-shadow 0.2s, transform 0.2s;
  }
  .post-card:hover {
    box-shadow: var(--shadow-card-hover);
    transform: translateY(-2px);
  }

  /* 条目标题是 h3（月份标题才是 h2），显式清掉 UA 外边距，避免卡片内顶部留白随层级变化 */
  .news-title {
    margin: 0 0 0.35rem;
    font-size: 1.1rem;
    font-weight: 700;
    line-height: 1.5;
  }

  .news-source {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.82rem;
    color: var(--muted);
    margin-bottom: 0.5rem;
  }
  .source-name { font-weight: 600; }
  .source-date { color: var(--muted); }

  .news-summary {
    font-size: 0.95rem;
    line-height: 1.65;
    color: var(--text);
    margin-bottom: 0.5rem;
  }

  .news-link {
    display: inline-block;
    font-size: 0.88rem;
    color: var(--accent);
    text-decoration: none;
    font-weight: 500;
  }
  .news-link:hover { text-decoration: underline; }
  .news-link.disabled {
    color: var(--muted);
    font-weight: 400;
  }

  .empty-state {
    text-align: center;
    color: var(--muted);
    font-size: 1.1rem;
    padding: 4rem 1rem;
  }

  /* .footer 在 src/styles/tokens.css（三页共用一份） */

  @media (max-width: 480px) {
    .hero { padding: 3rem 1.25rem 2rem; }
    .post-list { padding: 1.5rem 1rem 3rem; }
  }

  /* 分页在 src/styles/tokens.css（与首页共用一份） */

  a:focus-visible,
  button:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
</style>

  </body>
</html>
