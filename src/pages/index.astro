---
import { base, absoluteUrl } from '../consts';
import { getPosts, postSlug, readingMinutes } from '../lib/posts';
import '../styles/tokens.css';
import '../styles/hero.css';

const posts = await getPosts();

const siteTitle = 'StaryFall — 学习与构建的技术博客';
const siteDescription = '关于 AI Agent、MCP、开源项目深度解析与前端工程化的技术博客。';
const canonical = absoluteUrl('/');

// 首屏统计与标签
const tagCount = new Set(posts.flatMap((post) => post.data.tags)).size;
const latestDate = posts[0]?.data.date;

// 最新一篇做成横跨整行的特稿卡片，其余走两列栅格
const [featured, ...rest] = posts;
// 特稿 + 其余合并成一个有序数组，保证 data-pagination-card 的全局顺序与文章顺序一致
const ordered = featured ? [featured, ...rest] : [];
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{siteTitle}</title>
    <meta name="description" content={siteDescription} />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="StaryFall" />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:title" content={siteTitle} />
    <meta property="og:description" content={siteDescription} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <meta name="theme-color" content="#2563eb" />
    <link rel="alternate" type="application/rss+xml" title="StaryFall" href={`${base}/rss.xml`} />
  </head>
  <body>
    <header class="hero">
      <div class="hero-inner">
        <p class="hero-badge">
          <span class="dot" aria-hidden="true"></span>
          {posts.length} 篇文章 · {tagCount} 个标签
        </p>
        <h1>StaryFall</h1>
        <p class="tagline">学习与构建的技术博客</p>
        <nav class="hero-nav" aria-label="站点导航">
          <a href={`${base}/tags/`}>标签</a>
          <a href={`${base}/work/`}>作品</a>
          <a href={`${base}/feed/`}>AI 速递</a>
          <a href={`${base}/rss.xml`}>RSS</a>
          <a href="https://github.com/BlueBridge-E" rel="me">GitHub</a>
        </nav>
      </div>
    </header>

    <main class="page">
      <div class="section-head">
        <h2>最近更新</h2>
        {latestDate && (
          <time datetime={latestDate.toISOString()}>
            最新一篇 · {latestDate.toLocaleDateString('zh-CN')}
          </time>
        )}
      </div>

      <div class="post-grid">
        {ordered.map((post, index) => {
          const tags = post.data.tags;
          const minutes = readingMinutes(post.body);
          const isFeatured = index === 0;
          return (
            <article
              class:list={['post-card', { 'post-card--featured': isFeatured }]}
              data-pagination-card
            >
              {isFeatured && <span class="featured-badge">最新</span>}
              <div class="card-top">
                {post.data.date && (
                  <time datetime={post.data.date.toISOString()}>
                    {post.data.date.toLocaleDateString('zh-CN')}
                  </time>
                )}
                <span class="dot" aria-hidden="true"></span>
                <span>{minutes} 分钟</span>
              </div>
              <a href={`${base}/posts/${postSlug(post.id)}/`} class="post-title">
                {post.data.title}
              </a>
              <p class="post-desc">{post.data.description}</p>
              {tags.length > 0 && (
                <ul class="post-tags">
                  {tags.slice(0, isFeatured ? 8 : 4).map((tag) => (
                    <li>
                      <a href={`${base}/tags/${encodeURIComponent(tag)}/`} class="tag">
                        #{tag}
                      </a>
                    </li>
                  ))}
                </ul>
              )}
            </article>
          );
        })}
      </div>

      <nav class="pagination" id="pagination" data-pagination data-page-size="10" aria-label="分页">
        <button class="page-btn" id="firstPage">
          <span aria-hidden="true">«</span> 第一页
        </button>
        <button class="page-btn" id="prevPage">← 上一页</button>
        <span class="page-info" id="pageInfo"></span>
        <button class="page-btn" id="nextPage">下一页 →</button>
        <button class="page-btn" id="lastPage">
          最后一页 <span aria-hidden="true">»</span>
        </button>
      </nav>
    </main>

    <footer class="footer">
      <p>Built with Astro + Starlight · <a href={`${base}/rss.xml`}>RSS</a></p>
    </footer>

    <script>
      import { initPagination } from '../scripts/pagination';
      initPagination();
    </script>

<style>
  body {
    font-family: var(--font-sans);
    line-height: 1.6;
    color: var(--text);
    background: var(--bg);
    -webkit-font-smoothing: antialiased;
  }

  /* ── 头图样式在 src/styles/hero.css（与 /feed、/work 共用） ── */

  /* ── 正文容器 ── */
  .page {
    max-width: var(--page-max);
    margin: 0 auto;
    padding: 2.5rem 1.5rem 4rem;
  }

  .section-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.35rem;
    padding-bottom: 0.7rem;
    border-bottom: 1px solid var(--border);
  }
  .section-head h2 {
    font-size: 1.15rem;
    font-weight: 700;
    letter-spacing: 0.01em;
  }
  .section-head time {
    font-size: 0.82rem;
    color: var(--muted);
  }

  /* ── 卡片栅格 ── */
  .post-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(420px, 1fr));
    gap: 1.15rem;
  }

  .post-card {
    /* 注意：分页脚本会给卡片写内联 display:block，所以卡片的排版不要依赖 display，
       内部布局用块级/普通流，需要横排的地方用 flex 放在子元素上。 */
    position: relative;
    padding: 1.4rem 1.5rem;
    background: var(--card-bg);
    border: 1px solid var(--border);
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-card);
    transition: box-shadow 0.2s, transform 0.2s, border-color 0.2s;
  }
  /* 左侧强调条：hover 时滑出 */
  .post-card::before {
    content: '';
    position: absolute;
    left: 0;
    top: 1.1rem;
    bottom: 1.1rem;
    width: 3px;
    border-radius: 0 3px 3px 0;
    background: var(--accent);
    opacity: 0;
    transform: scaleY(0.4);
    transition: opacity 0.2s, transform 0.2s;
  }
  .post-card:hover {
    box-shadow: var(--shadow-card-hover);
    border-color: rgba(37, 99, 235, 0.28);
    transform: translateY(-2px);
  }
  .post-card:hover::before {
    opacity: 1;
    transform: scaleY(1);
  }

  /* 最新一篇横跨两列 */
  .post-card--featured {
    grid-column: 1 / -1;
    padding: 1.8rem 2rem;
    background:
      radial-gradient(600px 200px at 100% 0%, rgba(37, 99, 235, 0.07), transparent 70%),
      var(--card-bg);
  }
  .post-card--featured .post-title {
    font-size: 1.55rem;
    line-height: 1.4;
  }
  .post-card--featured .post-desc {
    max-width: 62ch;
    font-size: 1rem;
  }
  .featured-badge {
    position: absolute;
    top: 1.5rem;
    right: 1.75rem;
    padding: 0.16rem 0.6rem;
    border-radius: 999px;
    background: var(--accent);
    color: #fff;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.06em;
  }

  .card-top {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    margin-bottom: 0.6rem;
    font-size: 0.79rem;
    color: var(--muted);
    letter-spacing: 0.02em;
  }

  .post-title {
    display: block;
    font-size: 1.16rem;
    font-weight: 700;
    line-height: 1.45;
    color: var(--text);
    text-decoration: none;
    transition: color 0.18s;
  }
  .post-title:hover {
    color: var(--accent);
  }

  .post-desc {
    margin-top: 0.5rem;
    color: var(--muted);
    font-size: 0.93rem;
    line-height: 1.7;
    /* 最多三行，避免卡片高低参差 */
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
    /*
     * 占满三行的高度。卡片由栅格拉伸成等高，但内部是普通块级流
     * （分页脚本会给卡片写内联 display:block，不能用 flex 把标签顶到底部），
     * 描述短的那张会让标签浮起来、和邻列对不齐。给个最小高度即可对齐底部。
     * 5.1em = 3 行 × line-height 1.7。
     */
    min-height: 5.1em;
  }
  .post-card--featured .post-desc {
    -webkit-line-clamp: 2;
    /* 2 行 × 1.7 */
    min-height: 3.4em;
  }

  .post-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 0.85rem;
    padding: 0;
    list-style: none;
  }
  .tag {
    display: inline-block;
    padding: 0.1rem 0.52rem;
    border-radius: 999px;
    background: var(--accent-soft);
    color: var(--accent);
    font-size: 0.75rem;
    text-decoration: none;
    transition: background 0.18s, color 0.18s;
  }
  .tag:hover {
    background: var(--accent);
    color: #fff;
  }

  /* ── 分页 ── */
  .pagination {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 1rem;
    margin-top: 2.5rem;
  }
  .page-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0.55em 1.25em;
    border-radius: 999px;
    background: var(--card-bg);
    color: var(--accent);
    cursor: pointer;
    font: inherit;
    font-size: 0.88rem;
    font-weight: 600;
    border: 1px solid var(--border);
    transition: background 0.2s, border-color 0.2s;
  }
  .page-btn:hover:not(:disabled) {
    background: var(--accent-soft);
    border-color: var(--accent);
  }
  .page-btn:disabled {
    opacity: 0.4;
    cursor: default;
  }
  .page-info {
    font-size: 0.88rem;
    color: var(--muted);
    font-weight: 500;
    font-variant-numeric: tabular-nums;
  }

  .footer {
    padding: 2.25rem 1.5rem 3rem;
    text-align: center;
    font-size: 0.84rem;
    color: var(--muted);
    border-top: 1px solid var(--border);
  }
  .footer a {
    color: var(--accent);
    text-decoration: none;
  }

  a:focus-visible,
  button:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  @media (max-width: 900px) {
    .post-grid {
      grid-template-columns: 1fr;
    }
    .post-card--featured {
      padding: 1.5rem 1.4rem;
    }
    .post-card--featured .post-title {
      font-size: 1.3rem;
    }
    .featured-badge {
      position: static;
      display: inline-block;
      margin-bottom: 0.6rem;
    }
  }

  @media (max-width: 480px) {
    .page {
      padding: 1.75rem 1rem 3rem;
    }
    .section-head {
      flex-direction: column;
      gap: 0.3rem;
    }
    .pagination {
      flex-wrap: wrap;
    }
  }
</style>

  </body>
</html>
