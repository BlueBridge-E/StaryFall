---
import Layout from '../../layouts/TagLayout.astro';
import { base } from '../../consts';
import { getPosts, postSlug } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPosts();
  const tagSet = new Set<string>();
  for (const post of posts) {
    for (const tag of post.data.tags) {
      tagSet.add(tag);
    }
  }
  return [...tagSet].map((tag) => ({ params: { tag } }));
}

const { tag } = Astro.params;
const posts = (await getPosts()).filter((post) => post.data.tags.includes(tag));
---

<Layout
  title={`标签: #${tag}`}
  description={`StaryFall 中带有 #${tag} 标签的全部文章，共 ${posts.length} 篇。`}
>
  <p class="post-count">{posts.length} 篇文章</p>

  {posts.length > 0 ? (
    <ul class="post-list">
      {posts.map((post) => (
        <li>
          <a href={`${base}/posts/${postSlug(post.id)}/`}>
            <h2 class="post-title">{post.data.title}</h2>
            {post.data.date && (
              <span class="post-date">
                {post.data.date.toLocaleDateString('zh-CN')}
              </span>
            )}
          </a>
        </li>
      ))}
    </ul>
  ) : (
    <p>暂无该标签的文章。</p>
  )}

  <p style="margin-top: 2rem;">
    <a href={`${base}/tags/`}><span aria-hidden="true">&larr;</span> 查看所有标签</a>
  </p>
</Layout>

<style>
  .post-count { margin-bottom: 1rem; color: var(--sl-color-gray-2); }
  .post-list { list-style: none; padding: 0; }
  .post-list li { margin-bottom: 0.5rem; }
  /*
   * 这页不走 Starlight，`.post-list a` 也没有 color 规则；TagLayout 里的
   * `a { color: inherit }` 会被 Astro 作用域化成 a:where(.astro-taglayout)，
   * 而列表是本站组件渲染的，匹配不上 —— 不显式指定就会退化成浏览器默认的链接蓝。
   * 同理 h2 需要清掉 UA 的字号/粗细/外边距，才能保持原来的纯文本观感。
   */
  .post-title {
    margin: 0;
    font-size: inherit;
    font-weight: inherit;
    color: var(--text);
    transition: color 0.18s;
  }
  .post-list a {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.6rem 0;
    border-bottom: 1px solid var(--sl-color-gray-5);
    text-decoration: none;
  }
  .post-list a:hover .post-title { color: var(--sl-color-text-accent); }
  .post-list a:focus-visible {
    outline: 2px solid var(--sl-color-text-accent);
    outline-offset: 2px;
  }
  .post-date {
    font-size: 0.85rem;
    color: var(--sl-color-gray-2);
    white-space: nowrap;
    margin-left: 1rem;
  }
</style>
