---
// src/pages/work.astro — 作品集页面（GitHub API 自动拉取 + 静态 fallback）

import { base } from '../consts';
import SiteHead from '../components/SiteHead.astro';
import '../styles/tokens.css';
import '../styles/hero.css';

const pageTitle = '作品 — StaryFall';
const pageDescription = 'AI 工具与工程化项目作品集：MCP Server、Tauri 桌面应用、Agent 工作流与自建基础设施。';

// Repos 配置（自动拉取的 GitHub 仓库）
// 注意：这里列出的仓库若不存在，构建时会打印 404 警告并在页面上留下坏链接。
// 2026-06 移除了 cyber-coin 与 Giuseppe 两个已失效（404）的仓库。
const GITHUB_REPOS = [
  'BlueBridge-E/lighthouse-mcp',
  'BlueBridge-E/StaryFall',
  'BlueBridge-E/cn30days-skill',
];

/**
 * 模板里手写的静态项目卡片数量（见下方「非 GitHub 项目（纯静态）」注释块，当前 2 张）。
 * 头图徽标显示的是「项目总数」，必须是 GITHUB_REPOS.length + 本值 ——
 * 之前只写了 GITHUB_REPOS.length，徽标显示「3 个项目」而页面实际有 5 张卡片。
 * 增删静态卡片时记得同步这里。
 */
const STATIC_PROJECT_COUNT = 2;
const TOTAL_PROJECTS = GITHUB_REPOS.length + STATIC_PROJECT_COUNT;

// 项目元数据（描述、标签、icon 等）手写，其他字段自动从 GitHub API 拉取
const PROJECT_META: Record<string, { icon: string; desc: string; tags: { label: string; class?: string }[] }> = {
  'lighthouse-mcp': {
    icon: '🦞',
    desc: 'MCP Server for Tencent Cloud Lighthouse — 让 AI Agent 通过自然语言管理轻量服务器。封装 9 个管理工具（实例/监控/防火墙/快照/远程命令），支持 Claude Code / OpenClaw / Cursor 等 MCP 客户端。',
    tags: [
      { label: 'TypeScript', class: 'ts' },
      { label: 'MCP' },
      { label: '腾讯云' },
    ],
  },
  'StaryFall': {
    icon: '🌠',
    desc: '个人技术博客，基于 Astro + Starlight 构建，GitHub Actions 自动部署至 GitHub Pages。涵盖前端开发、AI 编码工具、协议分析等深度技术文章，支持标签分类与 SEO。',
    tags: [
      { label: 'Astro' },
      { label: 'Starlight' },
      { label: 'GitHub Actions' },
    ],
  },
  'cn30days-skill': {
    icon: '🇨🇳',
    desc: '中国互联网全网热搜聚合引擎 — OpenClaw AI Agent Skill。微博热搜、百度趋势、B站热门、GitHub 精选、权威媒体 RSS 五源并发采集，跨平台热度归一化排序，AI 自动合成叙事化深度报告。零 API key 即用，受 last30days-skill 启发。',
    tags: [
      { label: 'Python' },
      { label: 'Agent Skill' },
      { label: '多源聚合' },
    ],
  },
};

// 从 GitHub API 拉取 repo 数据（构建时运行）
interface GithubRepo {
  name: string;
  stargazers_count?: number;
  language?: string | null;
  pushed_at?: string;
  updated_at?: string;
}

type RepoData = { stars: number; language: string; updatedAt: string };

async function fetchGithubRepos(): Promise<Record<string, RepoData>> {
  const results: Record<string, RepoData> = {};
  // 有 token 时用认证请求（5000 次/小时），否则退化为匿名 60 次/小时（按 IP）。
  const token = process.env.GITHUB_TOKEN;
  const headers: Record<string, string> = {
    'User-Agent': 'StaryFall/1.0',
    Accept: 'application/vnd.github+json',
  };
  if (token) headers.Authorization = `Bearer ${token}`;

  const responses = await Promise.all(
    GITHUB_REPOS.map(async (repo) => {
      try {
        const r = await fetch(`https://api.github.com/repos/${repo}`, {
          headers,
          // 构建期请求必须带超时：api.github.com 一旦卡住，没有 signal 会把 CI
          // 一直挂到 runner 上限。8 秒仍未响应就退化为「省略 star 与更新时间」。
          signal: AbortSignal.timeout(8000),
        });
        if (!r.ok) {
          console.warn(
            `[work] GitHub API ${r.status} for ${repo}` +
              (r.status === 403 || r.status === 429
                ? '（很可能是限流：未设置 GITHUB_TOKEN 时限额为 60 次/小时/IP）'
                : ''),
          );
          return null;
        }
        return (await r.json()) as GithubRepo;
      } catch (error) {
        console.warn(`[work] GitHub API 请求失败 ${repo}: ${(error as Error).message}`);
        return null;
      }
    }),
  );

  for (const repo of responses) {
    if (repo?.name) {
      results[repo.name] = {
        stars: repo.stargazers_count ?? 0,
        language: repo.language ?? '',
        updatedAt: repo.pushed_at ?? repo.updated_at ?? '',
      };
    }
  }

  const missing = GITHUB_REPOS.filter((full) => !results[full.split('/')[1]!]);
  if (missing.length > 0) {
    console.warn(`[work] ${missing.length}/${GITHUB_REPOS.length} 个仓库未取到数据，卡片将省略 star 与更新时间：${missing.join(', ')}`);
  }

  return results;
}

const githubData = await fetchGithubRepos();

// 格式化日期
function fmtDate(iso: string | undefined) {
  if (!iso) return '';
  const d = new Date(iso);
  const now = new Date();
  const dayMs = 86400000;
  const diff = now.getTime() - d.getTime();
  if (diff < dayMs) return '今天';
  if (diff < 2 * dayMs) return '昨天';
  if (diff < 7 * dayMs) return Math.floor(diff / dayMs) + ' 天前';
  return d.toLocaleDateString('zh-CN', { month: 'short', day: 'numeric' });
}

/** 1234 -> 1.2k，避免长数字撑破卡片 */
function fmtStars(n: number) {
  return n >= 1000 ? `${(n / 1000).toFixed(1).replace(/\.0$/, '')}k` : String(n);
}

// 获取项目数据
function getProject(name: string) {
  const meta = PROJECT_META[name];
  const data = githubData[name];
  return { meta, github: data };
}
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <SiteHead title={pageTitle} description={pageDescription} path="/work/" />
  </head>
  <body>
    <header class="hero">
      <div class="hero-inner">
        <p class="hero-badge">
          <span class="dot" aria-hidden="true"></span>
          {TOTAL_PROJECTS} 个项目 · 持续更新
        </p>
        <h1>作品</h1>
        <p class="tagline">Build AI-powered tools.</p>
        <nav class="hero-nav" aria-label="站点导航">
          <a href={`${base}/`}>首页</a>
          <a href={`${base}/tags/`}>标签</a>
          <a href={`${base}/feed/`}>AI 速递</a>
          <a href="https://github.com/BlueBridge-E">GitHub</a>
        </nav>
      </div>
    </header>

    <main class="work-list">
      <!-- GitHub Repos（自动拉取） -->
      {
        GITHUB_REPOS.map((fullName) => {
          const name = fullName.split('/')[1];
          const { meta, github } = getProject(name);
          if (!meta) return null;
          return (
            <a href={`https://github.com/${fullName}`} class="work-card" target="_blank" rel="noopener">
              <div class="work-header">
                <span class="work-icon" aria-hidden="true">{meta.icon}</span>
                <div>
                  <h2 class="work-title">{name}</h2>
                  <p class="work-tags">
                    {meta.tags.map((t) => (
                      <span class={`lang-tag ${t.class ?? ''}`}>{t.label}</span>
                    ))}
                  </p>
                </div>
                <div class="work-stats">
                  {github && (
                    <>
                      {github.stars > 0 && (
                        <span class="stat stat--stars" title={`${github.stars} stars`}>
                          ★ {fmtStars(github.stars)}
                        </span>
                      )}
                      {github.updatedAt && (
                        <span class="stat stat--time">{fmtDate(github.updatedAt)}</span>
                      )}
                    </>
                  )}
                </div>
              </div>
              <p class="work-desc">{meta.desc}</p>
            </a>
          );
        })
      }

      <!-- 非 GitHub 项目（纯静态） -->

      <div class="work-card work-card--no-link">
        <div class="work-header">
          <span class="work-icon" aria-hidden="true">🤖</span>
          <div>
            <h2 class="work-title">OpenClaw Agent 工作流系统</h2>
            <p class="work-tags">
              <span class="lang-tag">Agent</span>
              <span class="lang-tag">Cron</span>
              <span class="lang-tag">多通道</span>
            </p>
          </div>
        </div>
        <p class="work-desc">
          自建 AI 资讯采集与深度解读管线。多源信息聚合 → LLM 加工 → QQ/微信双通道分发。
          每日 12:00 自动推送 InfoQ 精选 + AI 新闻速递，全年稳定运行。
          支持 cron 任务调度、IMA 知识空间归档、故障自愈机制。
        </p>
      </div>

      <div class="work-card work-card--no-link">
        <div class="work-header">
          <span class="work-icon" aria-hidden="true">☁️</span>
          <div>
            <h2 class="work-title">自建 AI 基础设施</h2>
            <p class="work-tags">
              <span class="lang-tag">OpenClaw</span>
              <span class="lang-tag">Nginx</span>
              <span class="lang-tag">Lighthouse</span>
            </p>
          </div>
        </div>
        <p class="work-desc">
          腾讯云上海 Lighthouse 服务器上的完整 AI Agent 基础设施。
          含 OpenClaw 多通道通信网关、Nginx 反代、MCP Server 托管、cron 调度系统。
          全年 24x7 稳定运行。
        </p>
      </div>
    </main>

    <footer class="footer">
      <p>Built with Astro · Deployed on GitHub Pages</p>
    </footer>
  </body>
</html>

<style>
  body {
    font-family: var(--font-sans);
    line-height: 1.6;
    color: var(--text);
    background: var(--bg);
  }

  /* 头图样式在 src/styles/hero.css（与首页、/feed 共用） */

  .work-list {
    max-width: var(--page-max);
    margin: 0 auto;
    padding: 2rem 1.5rem 4rem;
    display: grid;
    /* min() 夹住列宽下限：视口窄于 420px 时列宽自动退到 100%，
       否则 minmax(420px, 1fr) 会强制 420px 把整页撑出横向滚动条（手机竖屏） */
    grid-template-columns: repeat(auto-fill, minmax(min(420px, 100%), 1fr));
    gap: 1.15rem;
    align-content: start;
  }

  .work-card {
    display: block;
    padding: 1.75rem;
    margin-bottom: 0;
    background: var(--card-bg);
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-card);
    text-decoration: none;
    color: inherit;
    transition: box-shadow 0.2s, transform 0.2s, border-color 0.2s;
    border: 1px solid transparent;
  }
  a.work-card:hover {
    box-shadow: var(--shadow-card-hover);
    transform: translateY(-2px);
    border-color: var(--accent);
  }
  .work-card--no-link {
    cursor: default;
  }
  .work-card--no-link:hover {
    box-shadow: var(--shadow-card);
    transform: none;
    border-color: transparent;
  }

  .work-header {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 0.75rem;
    flex-wrap: wrap;
  }
  .work-icon {
    font-size: 2rem;
    line-height: 1;
    flex-shrink: 0;
  }
  .work-title {
    font-size: 1.2rem;
    font-weight: 700;
  }
  .work-tags {
    display: flex;
    gap: 0.4rem;
    margin-top: 0.25rem;
    flex-wrap: wrap;
  }
  .lang-tag {
    display: inline-block;
    padding: 0.15em 0.65em;
    border-radius: 6px;
    font-size: 0.78rem;
    font-weight: 600;
    background: #f0f4ff;
    color: #4a6cc1;
  }
  /* 对比度需 ≥4.5:1（0.78rem 太小不算「大号文本」） */
  .lang-tag.ts { background: #e6f4ff; color: #1f5fa0; }

  .work-stats {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.85rem;
    color: var(--muted);
  }
  .stat {
    display: flex;
    align-items: center;
    gap: 0.2rem;
  }
  .stat--stars {
    color: #b45309;
    font-weight: 600;
  }
  .stat--time {
    font-size: 0.8rem;
  }

  .work-desc {
    color: var(--muted);
    font-size: 0.95rem;
    line-height: 1.7;
  }

  a:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  /* .footer 在 src/styles/tokens.css（三页共用一份） */

  @media (max-width: 480px) {
    .hero { padding: 3rem 1.25rem 2rem; }
    .work-list { padding: 1.5rem 1rem 3rem; }
    .work-header { gap: 0.5rem; }
    .work-stats { margin-left: 0; margin-top: 0.25rem; }
  }
</style>
